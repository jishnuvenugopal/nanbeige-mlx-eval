{
  "suite": "agentic_en",
  "description": "English agentic / tool-use readiness. Each case offers one or more tools and a natural-language request; the model must select the correct tool and emit a well-formed <tool_call> with the right arguments. Args are chosen to be deterministic (city names, emails, ISO dates, IANA timezones) so grading is fair. max_tokens is generous because Nanbeige4.2-3B reasons before emitting the call.",
  "language": "en",
  "category": "tool_use",
  "cases": [
    {
      "id": "en-tc-weather-tokyo",
      "prompt": "What's the weather in Tokyo right now?",
      "tools": [
        {"type": "function", "function": {"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"location": {"type": "string", "description": "City name"}}, "required": ["location"]}}}
      ],
      "expect": {"type": "tool_call", "tool": "get_weather", "args": {"location": "Tokyo"}, "args_match": "subset"},
      "max_tokens": 512
    },
    {
      "id": "en-tc-weather-paris-select",
      "prompt": "Will I need an umbrella in Paris today?",
      "tools": [
        {"type": "function", "function": {"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"location": {"type": "string", "description": "City name"}}, "required": ["location"]}}},
        {"type": "function", "function": {"name": "search_web", "description": "Search the web.", "parameters": {"type": "object", "properties": {"query": {"type": "string"}}, "required": ["query"]}}}
      ],
      "expect": {"type": "tool_call", "tool": "get_weather", "args": {"location": "Paris"}, "args_match": "subset"},
      "max_tokens": 512
    },
